# URL бэкенда (FastAPI). Vercel проксирует на него запросы /api/*
BACKEND_URL=http://localhost:8000

# Прямой WebSocket-адрес FastAPI для чата марафонов.
# Локально можно не задавать: страница сама подключится к localhost:8000.
# В продакшене укажите wss://api.example.com (без /api).
NEXT_PUBLIC_WS_URL=

# Ссылки на оплату в Paywall для каждого тарифа
NEXT_PUBLIC_PAYWALL_STANDARD=
NEXT_PUBLIC_PAYWALL_PRO=
NEXT_PUBLIC_PAYWALL_PREMIUM=

# Контакты в футере (по умолчанию — бот)
NEXT_PUBLIC_SUPPORT_URL=https://t.me/lvs_key_bot
