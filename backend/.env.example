# --- общие для API и бота ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lvs
SITE_URL=http://localhost:3000
# Telegram ID админов через запятую (получают is_admin при первом входе)
ADMIN_TELEGRAM_IDS=

# --- API ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# false только для локальной разработки по http
COOKIE_SECURE=false
BOT_USERNAME=lvs_key_bot

# --- бот ---
BOT_TOKEN=
# ID закрытых групп/каналов по тарифам (отрицательные числа вида -100123...)
STANDARD_CHAT_ID=
PRO_CHAT_ID=
PREMIUM_CHAT_ID=
# как часто сверять активные подписки с составом групп
RECONCILE_INTERVAL_HOURS=6
